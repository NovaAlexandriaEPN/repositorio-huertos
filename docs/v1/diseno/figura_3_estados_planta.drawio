<mxfile host="app.diagrams.net"><diagram name="Figura 3 - Estados de una planta" id="d1"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="730" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="175.0" y="20" width="30" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Planeada&lt;/b&gt;&lt;hr&gt;La especie ya fue elegida para el huerto, pero todavía no se ha registrado su siembra." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="260" height="120" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Sembrada&lt;/b&gt;&lt;hr&gt;La siembra está registrada. También se puede registrar la señalética sin cambiar el estado." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="530" y="120" width="260" height="120" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Creciendo&lt;/b&gt;&lt;hr&gt;La planta recibió al menos un cuidado o riego. Se pueden registrar más cuidados, riegos, señalética, baño y ritual de gratitud sin cambiar el estado." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="530" y="350" width="260" height="120" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Cosechada&lt;/b&gt;&lt;hr&gt;La cosecha está registrada. También se puede registrar la limpieza de plantas sin cambiar el estado." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="260" height="120" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Secando&lt;/b&gt;&lt;hr&gt;El secado ya inició. Deben pasar al menos 10 días antes de registrar el empaquetado." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="260" height="120" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Empacada&lt;/b&gt;&lt;hr&gt;El empaquetado y etiquetado está registrado. El ciclo de esta selección queda completo." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="530" y="580" width="260" height="120" as="geometry"/></mxCell><mxCell id="c9" value="elegir especie y método" style="html=1;endArrow=open;endSize=10;rounded=0;labelBackgroundColor=default;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="registrar siembra&lt;br&gt;[preparación hecha hace&lt;br&gt;15 días o más]" style="html=1;endArrow=open;endSize=10;rounded=0;labelBackgroundColor=default;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="registrar cuidado o riego" style="html=1;endArrow=open;endSize=10;rounded=0;labelBackgroundColor=default;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="registrar cosecha" style="html=1;endArrow=open;endSize=10;rounded=0;labelBackgroundColor=default;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="registrar secado" style="html=1;endArrow=open;endSize=10;rounded=0;labelBackgroundColor=default;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="registrar empaquetado&lt;br&gt;[secado iniciado hace&lt;br&gt;10 días o más]" style="html=1;endArrow=open;endSize=10;rounded=0;labelBackgroundColor=default;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="El estado se deriva de las actividades activas. Si se anula la última actividad de la planta, el sistema recalcula su estado." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="470" y="15" width="320" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>